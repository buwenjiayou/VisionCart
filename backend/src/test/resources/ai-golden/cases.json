{
  "cases": [
    {
      "id": "semantic_preserve_price_and_student_preference",
      "type": "semantic_planner",
      "promptName": "semantic-planner-user",
      "promptVersion": "1.0",
      "required": true,
      "input": {
        "productName": "backpack",
        "category": "bags",
        "historyText": "budget under 100",
        "userInput": "find one for students"
      },
      "llmOutput": {
        "intent": "filter_current_results",
        "execution_mode": "PREFERENCE_RERANK",
        "hard_filters": [
          {"field": "price", "operator": "<=", "value": 100}
        ],
        "preferences": [
          {"code": "student_friendly", "user_meaning": "good for students", "weight": 0.8}
        ],
        "zero_result_policy": "KEEP_PREVIOUS_RESULTS"
      },
      "expected": {
        "executionMode": "PREFERENCE_RERANK",
        "hardFilter": {"field": "price", "operator": "<=", "value": 100},
        "preferenceCode": "student_friendly"
      }
    },
    {
      "id": "semantic_replace_price_constraint",
      "type": "semantic_planner",
      "promptName": "semantic-planner-user",
      "promptVersion": "1.0",
      "required": true,
      "input": {
        "productName": "earbuds",
        "category": "electronics",
        "historyText": "budget under 100",
        "userInput": "now change to above 200"
      },
      "llmOutput": {
        "intent": "filter_current_results",
        "execution_mode": "STRICT_FILTER",
        "hard_filters": [
          {"field": "price", "operator": ">=", "value": 200}
        ],
        "zero_result_policy": "KEEP_PREVIOUS_RESULTS"
      },
      "expected": {
        "executionMode": "STRICT_FILTER",
        "hardFilter": {"field": "price", "operator": ">=", "value": 200},
        "absentHardFilter": {"field": "price", "operator": "<="}
      }
    },
    {
      "id": "semantic_cancel_price_keep_student_preference",
      "type": "semantic_planner",
      "promptName": "semantic-planner-user",
      "promptVersion": "1.0",
      "required": true,
      "input": {
        "productName": "desk lamp",
        "category": "home",
        "historyText": "budget under 100",
        "userInput": "no price limit, only student friendly"
      },
      "llmOutput": {
        "intent": "filter_current_results",
        "execution_mode": "PREFERENCE_RERANK",
        "hard_filters": [],
        "preferences": [
          {"code": "student_friendly", "user_meaning": "good for students", "weight": 0.9}
        ],
        "zero_result_policy": "KEEP_PREVIOUS_RESULTS"
      },
      "expected": {
        "executionMode": "PREFERENCE_RERANK",
        "hardFilterCount": 0,
        "preferenceCode": "student_friendly"
      }
    },
