# 后端服务
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
JWT_SECRET=VisionCartLocalDevelopmentJwtSecretChangeMe1234567890
JWT_EXPIRATION=604800000
SERVER_ADDRESS=0.0.0.0
JPA_DDL_AUTO=update

# MySQL。开发和生产环境都使用真实数据库。
MYSQL_URL=jdbc:mysql://localhost:3306/visioncart?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# Docker Compose 部署默认自动使用 mysql 服务名；如需外部数据库再配置此项。
DOCKER_MYSQL_URL=
MYSQL_USERNAME=visioncart
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

# Redis。用于验证码、限流和自然语言语义缓存。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Web/CORS/WebSocket 安全配置。Android 原生请求不受 CORS 影响。
VISIONCART_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VISIONCART_ADMIN_USER_IDS=

# API 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_RECOGNITION_LIMIT=20
RATE_LIMIT_RECOGNITION_WINDOW_SECONDS=3600

# 火山引擎 Ark / 豆包。真实值只放在本地 .env 或部署平台环境变量中。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=replace-with-llm-key
ARK_LLM_MODEL=replace-with-llm-endpoint-id
ARK_VISION_API_KEY=replace-with-vision-key
ARK_VISION_MODEL=replace-with-vision-endpoint-id

# 阿里云百炼 / Qwen3-VL 两阶段识别
ALIYUN_BAILIAN_API_KEY=replace-with-bailian-key
ALIYUN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_FLASH_MODEL=qwen3-vl-flash
QWEN_VL_PLUS_MODEL=qwen3-vl-plus

# 邮箱验证码。请使用 SMTP 授权码，不要使用邮箱登录密码。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=replace-with-mailbox@example.com
MAIL_PASSWORD=replace-with-smtp-auth-code

# 拼多多 / 多多进宝
PDD_API_URL=https://gw-api.pinduoduo.com/api/router
PDD_CLIENT_ID=replace-with-client-id
PDD_CLIENT_SECRET=replace-with-secret
PDD_PID=replace-with-pid

# 淘宝联盟
TAOBAO_API_URL=https://eco.taobao.com/router/rest
TAOBAO_APP_KEY=replace-with-app-key
TAOBAO_APP_SECRET=replace-with-app-secret
TAOBAO_ADZONE_ID=replace-with-adzone-id

# eBay
EBAY_APP_ID=replace-with-app-id
EBAY_CERT_ID=replace-with-cert-id
EBAY_DEV_ID=replace-with-dev-id
EBAY_MARKETPLACE_ID=EBAY_US
