{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "./gradlew :backend:bootJar"
  },
  "deploy": {
    "startCommand": "java -jar backend/build/libs/backend-0.1.0.jar --spring.profiles.active=prod",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 120
  }
}
